{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    "@vheins/opencode-9router@latest"
  ],
  "default_agent": "orchestrator",
  "subagent_depth": 2,

  "permission": {
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow"
    },
    "edit": "allow",
    "bash": {
      "*": "ask",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git show*": "allow",
      "git branch*": "allow",
      "git push*": "deny",
      "git reset --hard*": "deny",
      "rm -rf*": "deny"
    },
    "task": "allow"
  },

  "agent": {
    "orchestrator": {
      "mode": "primary",
      "model": "9router/combo-sonnet",
      "steps": 40
    },

    "router": {
      "mode": "subagent",
      "model": "9router/combo-gemini",
      "steps": 20,
      "permission": {
        "edit": "deny",
        "bash": "deny"
      }
    },

    "cheap-worker": {
      "mode": "subagent",
      "model": "9router/combo-free",
      "steps": 15,
      "permission": {
        "edit": "deny",
        "bash": "deny"
      }
    },

    "planner": {
      "mode": "subagent",
      "model": "9router/combo-gemini",
      "steps": 18,
      "permission": {
        "edit": "deny",
        "bash": "deny"
      }
    },

    "architect": {
      "mode": "subagent",
      "model": "9router/combo-opus",
      "steps": 25,
      "permission": {
        "edit": "deny",
        "bash": "deny"
      }
    },

    "debater": {
      "mode": "subagent",
      "model": "9router/combo-opus",
      "steps": 20,
      "permission": {
        "edit": "deny",
        "bash": "deny"
      }
    },

    "developer": {
      "mode": "subagent",
      "model": "9router/combo-opus",
      "steps": 45
    },

    "developer-standard": {
      "mode": "subagent",
      "model": "9router/combo-sonnet",
      "steps": 35
    },

    "qa-lead": {
      "mode": "subagent",
      "model": "9router/combo-gemini",
      "steps": 22,
      "permission": {
        "edit": "deny",
        "bash": "deny"
      }
    },

    "test-designer": {
      "mode": "subagent",
      "model": "9router/combo-gemini",
      "steps": 22,
      "permission": {
        "edit": "deny",
        "bash": "deny"
      }
    },

    "automation-engineer": {
      "mode": "subagent",
      "model": "9router/combo-sonnet",
      "steps": 35
    },

    "api-tester": {
      "mode": "subagent",
      "model": "9router/combo-gemini",
      "steps": 25,
      "permission": {
        "edit": "deny"
      }
    },

    "ui-tester": {
      "mode": "subagent",
      "model": "9router/combo-gemini",
      "steps": 25,
      "permission": {
        "edit": "deny"
      }
    },

    "failure-analyzer": {
      "mode": "subagent",
      "model": "9router/combo-gemini",
      "steps": 22,
      "permission": {
        "edit": "deny",
        "bash": "deny"
      }
    },

    "debugger": {
      "mode": "subagent",
      "model": "9router/combo-opus",
      "steps": 45
    },

    "flaky-test-analyzer": {
      "mode": "subagent",
      "model": "9router/combo-gemini",
      "steps": 20,
      "permission": {
        "edit": "deny",
        "bash": "deny"
      }
    },

    "performance-reviewer": {
      "mode": "subagent",
      "model": "9router/combo-opus",
      "steps": 25,
      "permission": {
        "edit": "deny",
        "bash": "deny"
      }
    },

    "code-reviewer": {
      "mode": "subagent",
      "model": "9router/combo-opus",
      "steps": 25,
      "permission": {
        "edit": "deny",
        "bash": "deny"
      }
    },

    "security-reviewer": {
      "mode": "subagent",
      "model": "9router/combo-opus",
      "steps": 25,
      "permission": {
        "edit": "deny",
        "bash": "deny"
      }
    },

    "release-gate": {
      "mode": "subagent",
      "model": "9router/combo-opus",
      "steps": 20,
      "permission": {
        "edit": "deny",
        "bash": "deny"
      }
    }
  }
}
