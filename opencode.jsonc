{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "orchestrator",
  "model": "MODEL_FREE",

  "permissions": [
    { "action": "read", "resource": "*.env", "effect": "deny" },
    { "action": "read", "resource": "*.env.*", "effect": "deny" },

    { "action": "shell", "resource": "git status *", "effect": "allow" },
    { "action": "shell", "resource": "git diff *", "effect": "allow" },
    { "action": "shell", "resource": "git log *", "effect": "allow" },

    { "action": "shell", "resource": "git commit *", "effect": "ask" },
    { "action": "shell", "resource": "git push *", "effect": "ask" }
  ],

  "agents": {
    "orchestrator": {
      "mode": "primary",
      "model": "MODEL_GEMINI",
      "steps": 30,
      "permissions": [
        { "action": "subagent", "resource": "*", "effect": "allow" },
        { "action": "edit", "resource": ".opencode/runtime/*", "effect": "allow" },
        { "action": "edit", "resource": ".opencode/artifacts/*", "effect": "allow" },
        { "action": "shell", "resource": "*", "effect": "ask" }
      ]
    },

    "planner": {
      "mode": "subagent",
      "model": "MODEL_GEMINI",
      "steps": 12,
      "permissions": [
        { "action": "edit", "resource": "*", "effect": "deny" },
        { "action": "shell", "resource": "*", "effect": "deny" }
      ]
    },

    "architect": {
      "mode": "subagent",
      "model": "MODEL_CLAUDE",
      "steps": 15,
      "permissions": [
        { "action": "edit", "resource": "*", "effect": "deny" },
        { "action": "shell", "resource": "*", "effect": "deny" }
      ]
    },

    "debater": {
      "mode": "subagent",
      "model": "MODEL_CLAUDE",
      "steps": 12,
      "permissions": [
        { "action": "edit", "resource": "*", "effect": "deny" },
        { "action": "shell", "resource": "*", "effect": "deny" }
      ]
    },

    "developer": {
      "mode": "subagent",
      "model": "MODEL_CLAUDE",
      "steps": 35,
      "permissions": [
        { "action": "read", "resource": "*.env", "effect": "deny" },
        { "action": "read", "resource": "*.env.*", "effect": "deny" },
        { "action": "edit", "resource": "*", "effect": "allow" },
        { "action": "shell", "resource": "git push *", "effect": "deny" },
        { "action": "shell", "resource": "git reset --hard *", "effect": "deny" },
        { "action": "shell", "resource": "rm -rf *", "effect": "deny" }
      ]
    },

    "qa-lead": {
      "mode": "subagent",
      "model": "MODEL_GEMINI",
      "steps": 18,
      "permissions": [
        { "action": "edit", "resource": "*", "effect": "deny" },
        { "action": "edit", "resource": ".opencode/runtime/*", "effect": "allow" },
        { "action": "edit", "resource": ".opencode/artifacts/*", "effect": "allow" },
        { "action": "shell", "resource": "*", "effect": "deny" }
      ]
    },

    "test-designer": {
      "mode": "subagent",
      "model": "MODEL_GEMINI",
      "steps": 18,
      "permissions": [
        { "action": "edit", "resource": "*", "effect": "deny" },
        { "action": "edit", "resource": ".opencode/runtime/*", "effect": "allow" },
        { "action": "edit", "resource": ".opencode/artifacts/*", "effect": "allow" }
      ]
    },

    "automation-engineer": {
      "mode": "subagent",
      "model": "MODEL_CLAUDE",
      "steps": 30,
      "permissions": [
        { "action": "read", "resource": "*.env", "effect": "deny" },
        { "action": "read", "resource": "*.env.*", "effect": "deny" },
        { "action": "edit", "resource": "*", "effect": "allow" },
        { "action": "shell", "resource": "git push *", "effect": "deny" }
      ]
    },

    "api-tester": {
      "mode": "subagent",
      "model": "MODEL_GEMINI",
      "steps": 22,
      "permissions": [
        { "action": "edit", "resource": "*", "effect": "deny" },
        { "action": "edit", "resource": ".opencode/runtime/*", "effect": "allow" },
        { "action": "edit", "resource": ".opencode/artifacts/*", "effect": "allow" },
        { "action": "shell", "resource": "*", "effect": "ask" }
      ]
    },

    "ui-tester": {
      "mode": "subagent",
      "model": "MODEL_GEMINI",
      "steps": 22,
      "permissions": [
        { "action": "edit", "resource": "*", "effect": "deny" },
        { "action": "edit", "resource": ".opencode/runtime/*", "effect": "allow" },
        { "action": "edit", "resource": ".opencode/artifacts/*", "effect": "allow" },
        { "action": "shell", "resource": "*", "effect": "ask" }
      ]
    },

    "failure-analyzer": {
      "mode": "subagent",
      "model": "MODEL_GEMINI",
      "steps": 18,
      "permissions": [
        { "action": "edit", "resource": "*", "effect": "deny" },
        { "action": "edit", "resource": ".opencode/runtime/*", "effect": "allow" },
        { "action": "edit", "resource": ".opencode/artifacts/*", "effect": "allow" }
      ]
    },

    "debugger": {
      "mode": "subagent",
      "model": "MODEL_CLAUDE",
      "steps": 30,
      "permissions": [
        { "action": "read", "resource": "*.env", "effect": "deny" },
        { "action": "read", "resource": "*.env.*", "effect": "deny" },
        { "action": "edit", "resource": ".opencode/runtime/*", "effect": "allow" },
        { "action": "edit", "resource": ".opencode/artifacts/*", "effect": "allow" },
        { "action": "edit", "resource": "*", "effect": "allow" },
        { "action": "shell", "resource": "git reset --hard *", "effect": "deny" },
        { "action": "shell", "resource": "rm -rf *", "effect": "deny" }
      ]
    },

    "flaky-test-analyzer": {
      "mode": "subagent",
      "model": "MODEL_GEMINI",
      "steps": 15,
      "permissions": [
        { "action": "edit", "resource": "*", "effect": "deny" },
        { "action": "edit", "resource": ".opencode/runtime/*", "effect": "allow" }
      ]
    },

    "performance-reviewer": {
      "mode": "subagent",
      "model": "MODEL_CLAUDE",
      "steps": 15,
      "permissions": [
        { "action": "edit", "resource": "*", "effect": "deny" },
        { "action": "shell", "resource": "*", "effect": "deny" }
      ]
    },

    "code-reviewer": {
      "mode": "subagent",
      "model": "MODEL_CLAUDE",
      "steps": 18,
      "permissions": [
        { "action": "edit", "resource": "*", "effect": "deny" },
        { "action": "shell", "resource": "*", "effect": "deny" }
      ]
    },

    "security-reviewer": {
      "mode": "subagent",
      "model": "MODEL_CLAUDE",
      "steps": 18,
      "permissions": [
        { "action": "edit", "resource": "*", "effect": "deny" },
        { "action": "shell", "resource": "*", "effect": "deny" }
      ]
    },

    "release-gate": {
      "mode": "subagent",
      "model": "MODEL_CLAUDE",
      "steps": 15,
      "permissions": [
        { "action": "edit", "resource": "*", "effect": "deny" },
        { "action": "shell", "resource": "*", "effect": "deny" }
      ]
    }
  },

  "commands": {
    "feature": {
      "description": "Full feature development and QA lifecycle",
      "template": "Run the V3 feature workflow for: $ARGUMENTS. Classify the task, create a task ID and state, run planning/architecture/QA/debate as appropriate, implement, test, classify failures, repair up to 3 times, independently review, run security review when relevant, and execute release gate. Never invent evidence.",
      "agent": "orchestrator"
    },
    "bug": {
      "description": "Reproduce, diagnose, fix and regression-test a bug",
      "template": "Run the V3 bug workflow for: $ARGUMENTS. Establish evidence, classify failure, perform RCA, implement the minimal fix, add regression coverage, retest up to 3 times, review and gate.",
      "agent": "orchestrator"
    },
    "qa": {
      "description": "Risk-based QA workflow",
      "template": "Run the V3 QA workflow for: $ARGUMENTS. Create risk analysis, requirements traceability, test design, relevant API/UI execution, failure classification and a release recommendation.",
      "agent": "orchestrator"
    },
    "automation": {
      "description": "Build and verify test automation",
      "template": "Run the V3 automation workflow for: $ARGUMENTS. Inspect the existing framework, design tests, implement automation, execute it, classify failures, repair up to 3 times and report evidence.",
      "agent": "orchestrator"
    },
    "review": {
      "description": "Independent review workflow",
      "template": "Run the V3 review workflow for: $ARGUMENTS. Execute code review, security review when relevant, performance review when relevant, then release gate. Do not modify application code.",
      "agent": "orchestrator"
    },
    "release": {
      "description": "Release gate workflow",
      "template": "Run the V3 release workflow for: $ARGUMENTS. Inspect requirements, test evidence, defects, code review, security review and risks. Return PASS, PASS_WITH_RISK or BLOCKED. Do not modify files.",
      "agent": "orchestrator"
    }
  }
}
