{
  "type": "object",
  "required": [
    "failure_id",
    "classification",
    "evidence",
    "confidence"
  ],
  "properties": {
    "failure_id": {
      "type": "string"
    },
    "classification": {
      "enum": [
        "PRODUCT_BUG",
        "TEST_BUG",
        "ENVIRONMENT",
        "FLAKY",
        "DEPENDENCY",
        "UNKNOWN"
      ]
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "next_owner": {
      "type": "string"
    },
    "recommended_action": {
      "type": "string"
    }
  }
}